## 14. Preparar os dados reais, calcular taxas e agrupar

A função interrompe o processo se faltarem colunas, houver nomes municipais sem correspondência, valores ausentes ou população inválida. Confirme se os dados são anuais ou mensais antes de executar.
def preparar_base_real(df_bruto, col_municipio, col_ano, mapa_indicadores, ano_analise, mensal=False):
    if not col_municipio or not col_ano or not mapa_indicadores: raise ValueError("Configure COL_MUNICIPIO, COL_ANO e MAPA_INDICADORES.")
    originais = [col_municipio, col_ano, *mapa_indicadores.values()]
    faltantes = [c for c in originais if c not in df_bruto.columns]
    if faltantes: raise ValueError(f"Cabeçalhos não encontrados: {faltantes}")
    d = df_bruto[originais].copy().rename(columns={col_municipio:"municipio_fonte", col_ano:"ano", **{v:k for k,v in mapa_indicadores.items()}})
    d["ano"] = pd.to_numeric(d["ano"], errors="coerce"); d = d[d["ano"] == ano_analise].copy()
    if d.empty: raise ValueError(f"Nenhuma linha encontrada para {ano_analise}.")
    d["chave_nome"] = d["municipio_fonte"].map(normalizar_nome)
    d = d.merge(municipios_ibge[["codigo_municipio","municipio_ibge","chave_nome"]], on="chave_nome", how="left", validate="many_to_one")
    sem_match = d.loc[d["codigo_municipio"].isna(), "municipio_fonte"].drop_duplicates().tolist()
    if sem_match: raise ValueError(f"Nomes sem correspondência IBGE; revise antes de continuar: {sem_match[:25]}")
    indicadores = list(mapa_indicadores.keys())
    for c in indicadores: d[c] = pd.to_numeric(d[c], errors="coerce")
    if d[indicadores].isna().any().any(): raise ValueError("Há indicadores ausentes ou não numéricos; investigue antes de treinar.")
    if mensal: d = d.groupby(["codigo_municipio","municipio_ibge","ano"], as_index=False)[indicadores].sum()
    elif d.duplicated(["codigo_municipio","ano"]).any(): raise ValueError("Duplicidade município/ano. Confira a estrutura antes de agregar.")
    pop = populacao_sp[populacao_sp["codigo_municipio"].isin(d["codigo_municipio"])][["codigo_municipio","populacao"]]
    d = d.merge(pop, on="codigo_municipio", how="left", validate="many_to_one")
    if d["populacao"].isna().any() or (d["populacao"] <= 0).any(): raise ValueError("População ausente/inválida para um ou mais municípios.")
    return d.rename(columns={"municipio_ibge":"municipio"})

