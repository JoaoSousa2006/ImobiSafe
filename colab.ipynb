## 12. Criar referência oficial de municípios do IBGE

A SSP-SP pode trazer apenas nomes. Esta célula consulta a lista oficial de municípios paulistas. O cruzamento por nome precisa ser revisado: não force correspondências ambíguas.
import requests, unicodedata, re

def normalizar_nome(valor):
    if pd.isna(valor): return ""
    texto = unicodedata.normalize("NFKD", str(valor).strip().upper())
    texto = "".join(ch for ch in texto if not unicodedata.combining(ch))
    texto = re.sub(r"[^A-Z0-9 ]", " ", texto)
    return re.sub(r"\s+", " ", texto).strip()

url_ibge_municipios = "https://servicodados.ibge.gov.br/api/v1/localidades/estados/SP/municipios"
r_ibge = requests.get(url_ibge_municipios, timeout=60); r_ibge.raise_for_status()
municipios_ibge = pd.DataFrame([{"codigo_municipio":str(x["id"]).zfill(7), "municipio_ibge":x["nome"], "chave_nome":normalizar_nome(x["nome"])} for x in r_ibge.json()])
print("Municípios na lista IBGE:", len(municipios_ibge)); display(municipios_ibge.head())
