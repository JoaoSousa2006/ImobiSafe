## 9. Pipeline de clusters para dados reais
O código abaixo roda depois que `base` estiver preenchida com dados oficiais, com uma linha por município e ano e colunas de contagem claramente definidas. A taxa é calculada por 1.000 habitantes. Não substitua valores ausentes por zero sem evidência de que zero significa ausência de ocorrências.
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt

def agrupar_municipios(base, colunas_ocorrencias, k=3):
    obrigatorias = {"codigo_municipio", "municipio", "ano", "populacao", *colunas_ocorrencias}
    faltantes = obrigatorias - set(base.columns)
    if faltantes:
        raise ValueError(f"Faltam colunas obrigatórias: {sorted(faltantes)}")
    dados = base.copy()
    dados = dados[dados["populacao"].notna() & (dados["populacao"] > 0)].copy()
    for c in colunas_ocorrencias:
        dados[c] = pd.to_numeric(dados[c], errors="coerce")
    if dados[colunas_ocorrencias].isna().any().any():
        raise ValueError("Há valores criminais ausentes. Investigue-os antes de treinar; não os transforme automaticamente em zero.")
    taxas = []
    for c in colunas_ocorrencias:
        nome = "taxa_" + c.removeprefix("ocorrencias_") + "_por_1000"
        dados[nome] = dados[c] / dados["populacao"] * 1000
        taxas.append(nome)
    X = StandardScaler().fit_transform(dados[taxas])
    if len(dados) <= k:
        raise ValueError("É necessário ter mais municípios do que clusters.")
    modelo = KMeans(n_clusters=k, random_state=42, n_init=20)
    dados["cluster"] = modelo.fit_predict(X)
    score = silhouette_score(X, dados["cluster"]) if dados["cluster"].nunique() > 1 and dados["cluster"].nunique() < len(dados) else None
    resumo = dados.groupby("cluster")[taxas].mean().round(3)
    resultado = dados[["codigo_municipio", "municipio", "ano", "populacao", *taxas, "cluster"]].sort_values(["cluster", "municipio"])
    return resultado, resumo, score, modelo

